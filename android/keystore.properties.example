# Copy this file to `keystore.properties` and fill in the real values.
# `keystore.properties` is gitignored - NEVER commit real passwords.
#
# Pull the real values from `kv_store.creds.android.roam`:
#   storeFile is relative to D:/.code/roam/frontend/ (rootProject)
#   storePassword + keyPassword come from kv_store.creds.android.roam.keystore_password / .key_password
#   keyAlias comes from kv_store.creds.android.roam.key_alias
#
# Alternative: set ROAM_KEYSTORE_PASSWORD / ROAM_KEY_ALIAS / ROAM_KEY_PASSWORD / ROAM_KEYSTORE_FILE env vars
# (CI-friendly path; build.gradle reads either source).

storeFile=../roam-release.keystore
storePassword=REPLACE_ME
keyAlias=REPLACE_ME
keyPassword=REPLACE_ME
